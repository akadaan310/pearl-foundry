# Pearl Foundry — server-only configuration. Copy to .env.local (never commit).

# The public origin of this deployment. Used for absolute URLs (copy buttons,
# AI instructions, manifests). Redeploys pick it up at build time.
NEXT_PUBLIC_SITE_ORIGIN=https://pearl-foundry.vercel.app

# The Pearl Runtime Substrate this deployment talks to. Must be https:
# (localhost http: allowed for development). When unset, /api/substrate/status
# honestly reports "not_configured" and everything still works — a Pearl lives
# in its URL.
PEARL_SUBSTRATE_URL=https://scenic-rpg-interaction-dod.trycloudflare.com

# Optional. A server-held bearer token for substrate calls that need auth
# (currently: mirroring named genome states to state.keep). Register a service
# actor (POST /api/v1/auth/ai/register), grant it state.keep, paste the token
# here. Without it, /api/foundry/state reports configured:false and the browser
# keeps states locally — the UI says which it is. NEVER expose to the client.
PEARL_API_KEY=
